# Supper Board – Einstellungen. Kopieren nach .env und anpassen.

# ---------- Allgemein ----------
# Passwort für das Board (Benutzername beliebig). Leer = kein Passwort.
# Unbedingt setzen, wenn das Board von außerhalb des Heimnetzes erreichbar ist.
SB_PASSWORD=
SB_TIMEZONE=Europe/Berlin
# Startsprache: de oder en (später im Board unter Feedback → Einrichtung umschaltbar)
SB_LANGUAGE=de
SB_HOUSEHOLD=ein Haushalt mit zwei Personen
# Adresse, unter der ihr das Board öffnet. Wird in Benachrichtigungen verlinkt.
SB_PUBLIC_URL=http://fedora-server.local:8080

# ---------- KI: claude | ollama | openai | none ----------
# none: Pläne werden aus eurer Rezeptdatenbank zusammengestellt, keine KI-Rezepte.
LLM_PROVIDER=none

# Claude (Anthropic-API). Schlüssel unter https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Denkaufwand: low | medium | high
CLAUDE_EFFORT=medium

# Ollama (lokal, nichts verlässt das Heimnetz).
# Ollama auf demselben Rechner: host.containers.internal; auf deinem PC: dessen IP, z. B. http://192.168.178.20:11434
OLLAMA_URL=http://host.containers.internal:11434
OLLAMA_MODEL=qwen3:14b
# Bildmodell für Fotos von Rezeptseiten, z. B. qwen2.5vl:7b (leer = OLLAMA_MODEL)
OLLAMA_VISION_MODEL=

# OpenAI-kompatibler Server (llama.cpp llama-server, LM Studio, vLLM – z. B. mit Unsloth-GGUF-Modellen)
# oder Cloud mit kostenlosem Kontingent. Nutzen mit LLM_PROVIDER=openai. Adresse inklusive /v1 bzw.:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai  (Modell z. B. gemini-2.5-flash)
#   OpenRouter:    https://openrouter.ai/api/v1                           (Modelle mit :free im Namen)
OPENAI_URL=http://192.168.178.20:8080/v1
OPENAI_MODEL=local
OPENAI_VISION_MODEL=
OPENAI_API_KEY=

# ---------- Einkauf ----------
SB_STORE_NAME=REWE
SB_STORE_URL=https://shop.rewe.de/
# Suchlink pro Artikel, {q} wird durch den Artikel ersetzt. Leer = keine Links.
SB_STORE_SEARCH_URL=https://shop.rewe.de/productList?search={q}
# Wochentag des Einkaufs (mo di mi do fr sa so)
SB_SHOP_DAY=sa
# Kommt bei jedem Plan mit auf die Liste
SB_ALWAYS_RESTOCK=Eier, Milch, Joghurt

# ---------- Zeitplan ----------
# Neuer Planentwurf (Wochentag + Uhrzeit)
SB_DRAFT_DAY=di
SB_DRAFT_TIME=06:50
# Einkaufsliste fertigstellen
SB_LIST_DAY=do
SB_LIST_TIME=17:50
# Auftau-Erinnerung am Vorabend
SB_THAW_TIME=20:00
# Optional: täglicher Hinweis, was es heute gibt (leer = aus)
SB_DINNER_TIME=

# ---------- Home Assistant ----------
# z. B. http://homeassistant.local:8123
HA_URL=
# Langlebiges Zugriffstoken (HA: Profil → Sicherheit → Langlebige Zugriffstoken)
HA_TOKEN=
# notify-Dienste, mit Komma getrennt, z. B. notify.mobile_app_pixel_8,notify.mobile_app_iphone
HA_NOTIFY=
